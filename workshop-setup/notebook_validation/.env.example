# notebook_validation — Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# Databricks Connection (required)
# =============================================================================

# CLI profile name (configured via: databricks configure --profile <name>)
DATABRICKS_PROFILE=""

# Existing all-purpose cluster ID to run jobs on (must be running or auto-startable)
DATABRICKS_CLUSTER_ID=""

# Remote workspace path where scripts are uploaded
WORKSPACE_DIR="/Workspace/Users/your-email/notebook_validation"

# =============================================================================
# Neo4j Aura Credentials (required for Lab 3 and Lab 4 validation scripts)
# =============================================================================

NEO4J_URI="neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

# =============================================================================
# Data Path (optional — defaults to workshop standard)
# =============================================================================

# Unity Catalog Volume path holding the Lab 3 maintenance manual. Only
# run_lab3_01.py reads this — the Lab 2 scripts load from the medallion
# pipeline's silver tables instead (see --catalog/--pipeline-schema in each
# script, which default to the same workshop standard).
DATA_PATH="/Volumes/databricks-neo4j-workshop/aircraft/raw_data"

# =============================================================================
# Neo4j MCP Server (Lab 3 notebook 04 validation)
# =============================================================================
#
# run_lab3_04_uc.py reaches the MCP server through the Unity Catalog HTTP
# connection (created via workshop-setup/MCP-MANUAL-SETUP.md), so no endpoint
# or API key is needed here. The connection name defaults to
# "neo4j_agentcore_mcp" in the script; override with --mcp-connection if yours
# differs.
