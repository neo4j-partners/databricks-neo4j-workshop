# The Neo4j on Databricks workshop's values, read by the Vocareum hooks.
#
# voclib.sh sources this out of /voc/scripts before any hook runs and exports
# everything in it, so voclab.py reads these as its own environment. See
# course.env.example for what each key means and what happens when it is unset.
#
# Nothing secret belongs here. The Aura connection goes into a Databricks secret
# scope created by workspace_init.sh, not into this file: it is uploaded to a
# host students share and voc_report_env prints VOC_ variables to the console.

# --- The student's cluster -------------------------------------------------

# An ML runtime, deliberately, against the package default of 17.3.x-scala2.13.
# Lab 3 runs sentence_transformers and Lab 4 runs the agent stack, and those
# resolve far faster onto a build that already carries the torch and transformers
# they sit on. This exact key is what the 2026-08-07 session ran, with all
# eleven libraries it then carried reaching INSTALLED and none FAILED. The list
# below has since grown to thirteen; the two Lab 6 entries were added after.
VOC_COURSE_SPARK_VERSION=17.3.x-cpu-ml-scala2.13

# Measured on the same session. The .cfg asked for m5.large and never got it:
# cluster_config is inert, and i3.xlarge is what the cluster actually carried.
VOC_COURSE_NODE_TYPE=i3.xlarge
VOC_COURSE_AUTOTERMINATION_MINUTES=90

# Hyphenated, so every SQL statement naming it has to backtick it. Kept as it is
# because it is the name the workshop's notebooks and the Genie space already
# use, and renaming it to please SQL quoting would break both.
VOC_COURSE_CATALOG=databricks-neo4j-workshop

# Where that catalog's managed tables physically live. Read by workshop.py, not
# by voclab.py, and appended to its CREATE CATALOG as a MANAGED LOCATION clause.
#
# Measured 2026-08-08, and the reason this key exists. The account this course
# deploys into has Databricks Default Storage enabled, so its metastore carries
# no storage_root, and a bare CREATE CATALOG fails there with
# "[INVALID_STATE] Metastore storage root URL does not exist". The path below is
# inside an external location the metastore holds, over an IAM role in the
# course owner's own AWS account, and naming it makes the same statement
# succeed. The catalog comes back as MANAGED_CATALOG with this as its
# storage_root.
#
# The alternative was to leave the catalog created by hand once and let
# CREATE CATALOG IF NOT EXISTS find it forever after, since a catalog belongs to
# the metastore and outlives every student workspace. That works and hides the
# dependency: the first deploy onto a different Databricks account fails with an
# error naming Default Storage rather than the setup step nobody repeated.
#
# Leave this empty on an account whose metastore has a storage_root of its own.
# workshop.py emits the plain statement when it is unset. See the "The AWS side"
# section of dbx-vocareum's setup-workshop-v2.md for what backs this path and
# how it was built.
VOC_COURSE_CATALOG_MANAGED_LOCATION=s3://dbx-neo4j-workshop-uc-852138520827/workshop

# The eleven libraries, in the order the .cfg listed them, plus the two Lab 6
# added. That list is the one thing in the .cfg observed doing work, and it is
# salvaged here rather than left there. Measured: the cluster reaches RUNNING in
# about 10 minutes and these take another 6 to reach INSTALLED, which is what
# lab_setup.sh pre-warming buys back.
#
# The last two entries are one library, and neither is ordinary. Read
# workshop-setup/README.md, "The neo4j-agent-memory wheel", before editing them.
# It is the one account of why, and it is not repeated here on purpose.
#
# The short version: neo4j-agent-memory ships as a wheel on the volume, built
# from a fork, because released 0.5.0 drops the graph edge Lab 6 is built on.
# httpx rides beside it because a wheel carries no extras. The whl: path is a
# literal string that nothing validates before thirty clusters install from it,
# so moving the volume, renaming the wheel or bumping the version means editing
# lab/workshop.py and this line together.
VOC_COURSE_LIBRARIES="maven:org.neo4j:neo4j-connector-apache-spark_2.13:5.4.3_for_spark_3, pypi:neo4j==6.2.0, pypi:databricks-agents>=1.11.0, pypi:langgraph==1.2.4, pypi:langchain-openai==1.3.0, pypi:pydantic==2.13.4, pypi:langchain-core>=1.4.6, pypi:databricks-langchain>=0.20.0, pypi:neo4j-graphrag>=1.17.0, pypi:beautifulsoup4>=4.15.0, pypi:sentence_transformers, whl:/Volumes/databricks-neo4j-workshop/aircraft/raw_data/neo4j_agent_memory-0.5.1.dev0+mentions-py3-none-any.whl, pypi:httpx>=0.27.0"

# --- What the student is handed -------------------------------------------

# This list is the single statement of what a Vocareum student gets. It used to
# be spread over three places that could disagree: a hand-maintained mirror under
# vocareum/courseware/, the .dat and .dbc zips built from it, and the `zip -r`
# ritual in vocareum/SETUP_GUIDE.md that built those zips. Two copies of one
# definition already drifted once in this repo, in the gold tables, and the
# symptom was a Genie space answering wrong. So the notebooks live in one place,
# lab/ reaches them by symlink, and what ships is stated here and only here.
#
# All three of those are gone. vocareum/courseware/, both zips and the mirrored
# notebooks were deleted on 2026-08-08, and the `zip -r` ritual is no longer in
# vocareum/SETUP_GUIDE.md. The mirror had drifted by the time it went, which is
# the argument for this list rather than an argument against it. Nothing above
# describes anything still on disk.
#
# Files are named one by one rather than by folder because the exclusion below is
# real and has to be visible. A folder name would ship whatever anybody adds to
# it later, and the first person to find out would be a student.
#
# The smoke test is first because the first name is where a student lands, and it
# is the notebook that says whether their cluster and their catalog are there.
#
# Labs 1 and 4 are browser labs: the Aura console in one, Genie and Agent Bricks
# in the other. They ship as notebooks anyway. A Vocareum student never clones
# this repository and never sees a rendered README, so a lab whose instructions
# live only in markdown is a lab with no instructions. Their notebooks carry the
# click-through steps as markdown cells beside the few cells that are actually
# runnable, and the order here is the order a student works through them.
#
# Left out on purpose: Lab_2_Databricks_ETL_Neo4j/02_gds_knn_aircraft.ipynb and
# everything under Appendix_A_GDS_Graph_Analytics/. Graph Data Science needs Aura
# Professional and Vocareum participants are on Aura Free, so shipping either one
# hands a student a notebook that cannot run.
#
# The last entry is a module, not a notebook, and that distinction was a defect
# before it was a feature. Lab 3 does `from data_utils import ...`, which needs a
# workspace file. notebook-import used to post format SOURCE with language
# PYTHON and strip the extension, which always produces a NOTEBOOK, and Python's
# import machinery refuses to import one. Every student in the 2026-08-08 class
# got `NotebookImportException: Unable to import module data_utils. The
# following file appears to be a notebook`.
#
# Fixed 2026-08-08 in dbx-vocareum commit 68e63a5, scoped to `.py`: the import
# posts format AUTO with no language, and the path keeps its extension, so a
# module with no `# Databricks notebook source` first line lands as a workspace
# FILE at `.../data_utils.py`. Both halves are needed, because AUTO at a path
# with no extension makes a FILE out of anything, notebooks included.
#
# This depends on the pinned dbx-vocareum version, not on this file.
# dbx-vocareum-upload injects voclab.py from the installed package, so an upload
# against a lock older than 68e63a5 ships the defect and hash-verifies it
# cleanly. Run `uv lock --upgrade-package dbx-vocareum-tools && uv sync` before
# uploading, and confirm NOTEBOOK_FORMATS[".py"] reads ("AUTO", None) in the
# venv's voclab.py.
#
# A course adding another `.py` helper here inherits the fix and needs nothing.
# One that wants a `.py` delivered as a notebook says so in the file itself, by
# giving it that first line. lab3-fix.md at the repository root carries the
# measurements, the table of which formats keep an extension, and what a
# returning student sees.
VOC_COURSE_NOTEBOOKS="00_cluster_smoke_test.ipynb,
                      Lab_1_Aura_Setup/01_aura_setup.ipynb,
                      Lab_2_Databricks_ETL_Neo4j/01_aircraft_etl_to_neo4j.ipynb,
                      Lab_3_Semantic_Search/01_data_and_embeddings.ipynb,
                      Lab_3_Semantic_Search/02_graphrag_retrievers.ipynb,
                      Lab_3_Semantic_Search/03_hybrid_retrievers.ipynb,
                      Lab_3_Semantic_Search/data_utils.py,
                      Lab_4_Compound_AI_Agents/04_genie_agent.ipynb,
                      Lab_5_LangGraph_Agent/01_langgraph_agent.ipynb,
                      Lab_5_LangGraph_Agent/tools.py,
                      Lab_5_LangGraph_Agent/agent.py,
                      Lab_6_Agent_Memory/01_agent_memory.ipynb,
                      Lab_6_Agent_Memory/memory.py"

# --- The SQL warehouse ----------------------------------------------------

# Named as the .cfg named it, so an instructor looking for it after a class finds
# the name they already know. workspace_init.sh needs it for the catalog, schema
# and volume DDL and for the Genie comments and grants, all of which go through
# the Statement Execution API and so need a warehouse_id.
VOC_COURSE_WAREHOUSE_NAME=shared_warehouse
VOC_COURSE_WAREHOUSE_SIZE=2X-Small
VOC_COURSE_WAREHOUSE_AUTO_STOP_MINUTES=10

# The starter warehouse Databricks creates with the workspace, which arrives at
# Small and carries a users CAN_USE grant. Put on the same size as the one above,
# so a student who opens the SQL editor and takes the default pays what this
# course chose rather than four times it. Resized on every workspace_init.sh,
# because Vocareum builds a workspace per part and a console fix lasts one class.
VOC_COURSE_STARTER_WAREHOUSE_SIZE=2X-Small
