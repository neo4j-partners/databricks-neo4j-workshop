# Environment files
.env
.env.*
*.env

# lab/course.env is the exception, and it has to be. It carries no secret: it is
# the catalog name, the runtime, and the library list, and it is what tells the
# Vocareum hooks which course they are provisioning. Uploaded to /voc/scripts
# with the hooks, so a copy that only exists on one laptop deploys a lab nobody
# else can reproduce.
!lab/course.env

# Credentials
.mcp-credentials.json

