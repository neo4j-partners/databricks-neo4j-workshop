# Databricks Workshop Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git - it contains sensitive information

# =============================================================================
# Databricks Configuration
# =============================================================================

# Databricks CLI profile name (configured via: databricks configure --profile <name>)
DATABRICKS_PROFILE=""

# =============================================================================
# Unity Catalog Volume (used by databricks-setup for data upload + tables)
# =============================================================================

# Catalog name
CATALOG_NAME="databricks-neo4j-workshop"

# Schema for the data volume
VOLUME_SCHEMA="aircraft"

# Volume name for CSV data upload
VOLUME_NAME="raw_data"

# Schema for lakehouse Delta tables
LAKEHOUSE_SCHEMA="aircraft"

# =============================================================================
# SQL Warehouse (used by databricks-setup for lakehouse table creation)
# =============================================================================

# SQL Warehouse name for lakehouse table creation via Statement Execution API
# The "Starter Warehouse" is available in most workspaces
WAREHOUSE_NAME="Starter Warehouse"

# Timeout for SQL statement execution in seconds
WAREHOUSE_TIMEOUT="600"

# =============================================================================
# Cluster Configuration (used by databricks-setup CLI)
# =============================================================================

# Cluster name
CLUSTER_NAME="Small Spark 4.0"

# Node type for the cluster
# Examples:
#   m5.large          —  8 GB,  2 cores (AWS default)
#   m5.xlarge         — 16 GB,  4 cores
#   Standard_D4ds_v5  — 16 GB,  4 cores (Azure)
NODE_TYPE=""

# Databricks runtime version
SPARK_VERSION="17.3.x-cpu-ml-scala2.13"

# Runtime engine: "STANDARD" or "PHOTON"
# Photon disabled by default - only benefits large workloads (>100GB) and charges 2x DBUs
RUNTIME_ENGINE="STANDARD"

# Cluster auto-termination in minutes
AUTOTERMINATION_MINUTES="30"

# =============================================================================
# User Settings
# =============================================================================

# Databricks user email (auto-detected from workspace credentials if empty)
USER_EMAIL=""

# =============================================================================
# Neo4j Aura Credentials (used by populate-aircraft-db and verify-labs)
# =============================================================================

NEO4J_URI="neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
