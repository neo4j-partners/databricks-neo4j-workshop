# ── Neo4j connection (required) ──────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here

# ── Extractor LLM provider (setup/enrich commands) ──────────────────────────
# Choose "openai" (default) or "anthropic".
# This setting only controls entity extraction; embeddings are configured
# separately with EMBEDDING_PROVIDER below.
# Pass --skip-extraction to setup or enrich to chunk, embed, and index without
# an extractor. No key from this section is needed on that path.
LLM_PROVIDER=openai

# ── Embeddings (setup/enrich commands) ──────────────────────────────────────
# Choose "bge" (default), "openai", or "databricks".
# "bge" runs BAAI/bge-large-en-v1.5 locally via sentence-transformers.
# It is 1024 dimensions, matching the Lab 3 maintenanceChunkEmbeddings index,
# and needs no API key. "openai" calls the OpenAI embeddings API instead.
# "databricks" calls the same Foundation Model endpoint Lab 3 uses, so the
# vectors this loader writes and the vectors Lab 3 writes come from one model.
# EMBEDDING_PROVIDER=bge
# BGE_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# BGE_EMBEDDING_DIMENSIONS=1024

# ── Databricks (required when EMBEDDING_PROVIDER=databricks) ────────────────
# Install with: uv sync --extra databricks
# Set either DATABRICKS_CONFIG_PROFILE (a profile in ~/.databrickscfg) or the
# host/token pair. Leave all three unset when running inside a Databricks
# notebook, where authentication is already in the environment.
# DATABRICKS_EMBEDDING_MODEL=databricks-bge-large-en
# DATABRICKS_EMBEDDING_DIMENSIONS=1024
# DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi-your-token-here

# ── OpenAI (required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai) ─
# Used for extraction when LLM_PROVIDER=openai and for Chunk embeddings when
# EMBEDDING_PROVIDER=openai. Not needed for the default BGE embeddings.
OPENAI_API_KEY=sk-your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
#
# Extraction model — used for entity extraction from maintenance manuals.
# Available models (see https://platform.openai.com/docs/models):
#
#   gpt-5.2        — Flagship model. Best for coding and agentic tasks. Most capable.
#   gpt-5.2-pro    — Extended-thinking variant of GPT-5.2 for complex reasoning.
#   gpt-5-mini     — Fast, cost-effective. Good balance of quality and speed. (default)
#   gpt-5-nano     — Smallest and cheapest. Best for high-volume, simple tasks.
#
# Embedding models (for OPENAI_EMBEDDING_MODEL, used when EMBEDDING_PROVIDER=openai):
#   text-embedding-3-small  — Fast, affordable embeddings (1536 dims, default)
#   text-embedding-3-large  — Most capable embeddings for English and multilingual
#
# OPENAI_EXTRACTION_MODEL=gpt-5-mini
# Higher values give GPT-5-family models room for structured JSON extraction.
# If you see "LLM response has improper format", do not lower this.
# OPENAI_EXTRACTION_MAX_COMPLETION_TOKENS=8000

# ── Anthropic (required for enrich when LLM_PROVIDER=anthropic) ─────────────
# Use this when you want Anthropic entity extraction.
# Install with: uv sync --extra anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-6
# ANTHROPIC_EXTRACTION_MAX_TOKENS=8000

# ── Chunking (enrich command) ───────────────────────────────────────────────
# Controls how maintenance manuals are split into chunks before embedding
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100

# Limit chunks processed per document (0 = no limit, process all).
# Set to a small number (e.g. 10) for quick test runs.
# ENRICH_SAMPLE_SIZE=0

# ── Samples (samples command) ───────────────────────────────────────────────
# Number of rows returned per section when running sample queries
# SAMPLE_SIZE=10
